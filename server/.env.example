# Copy to .env and fill in. .env stays off git.

# Neon connection string. It should end with ?sslmode=require
DATABASE_URL=

# Long random string. The server uses it to sign login sessions.
AUTH_SECRET=

# Where this API is hosted, and which site may call it.
# Locally these stay http://localhost. In production both are https
# addresses with no trailing slash. The site and the API are different
# hosts, so the session cookie is then sent as SameSite=None; Secure.
# CLIENT_ORIGIN can be a comma-separated list if you have more than one site URL.
BETTER_AUTH_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:5173

# Stripe test mode. Secret key from the Stripe dashboard (sk_test_...).
# Webhook secret comes from `stripe listen` locally, and from the dashboard
# webhook endpoint in production (whsec_...). Never commit the real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
